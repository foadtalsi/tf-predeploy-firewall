# Le contexte de build envoyé au démon.
#
# .venv seul fait 180 Mo, et il est recréé dans l'image de toute façon : le
# Dockerfile construit un wheel puis l'installe dans un interpréteur propre.

.venv/
.git/
.mypy_cache/
.pytest_cache/
.ruff_cache/
**/__pycache__/
dist/
build/

# Rien de ce qui suit n'entre dans l'image. Le Dockerfile ne copie que
# pyproject.toml, README.md et src/ ; les envoyer quand même ne fait que
# ralentir chaque build et invalider le cache sur des changements sans effet.
tests/
docs/
tools/
.github/
