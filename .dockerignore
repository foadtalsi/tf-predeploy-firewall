# The build context sent to the daemon.
#
# .venv alone weighs 180 MB, and it is rebuilt in the image anyway: the
# Dockerfile builds a wheel and installs it into a clean interpreter.

.venv/
.git/
.mypy_cache/
.pytest_cache/
.ruff_cache/
**/__pycache__/
dist/
build/

# Nothing below goes into the image. The Dockerfile copies only pyproject.toml,
# README.md, requirements/ and src/; sending the rest only slows every build down
# and invalidates the cache on changes that have no effect.
tests/
docs/
tools/
benchmarks/
.github/
